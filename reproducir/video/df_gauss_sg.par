# DF gaussiana de las notas con autogravedad (a0=1e-2), yoshida4 con dt=0.025,
# instantáneas cada 4 unidades hasta t=2400. Para reproducir/video/video_df.py.
state            = aa_quad
dftype           = gauss
a0               = 1.0e-2
sr               = 0.1
sp               = 0.1
l0               = 2.0
sl               = 0.2
jminc            = 0.0
jmaxc            = 0.6
lminc            = 1.6
lmaxc            = 2.4
Nrc              = 80
Npc              = 256
Nlc              = 48
cutoff           = 1.0e-3
dr               = 0.1
rmin             = 0.0
rmax             = 30.0
rminc            = 1.0
rmaxc            = 10.0
pminc            = -0.6
pmaxc            = 0.6
pmax             = 2.0
courant          = 0.5
integrator       = yoshida4
BGtype           = Isochrone
autointeraction  = .true.
Nt               = 96000
spatial_output   = 160
field_output     = 160
time_output      = 8000
output_format    = hdf5
directory        = rep/video/df_gauss_sg
